/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Vite fingerprints everything in /assets, so it can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sample paintings never change under the same name, so browsers can keep them for a year.
/samples/*
  Cache-Control: public, max-age=31536000, immutable

# The social image gets a new file name whenever it changes, so it can be cached for a year.
/social-preview.png
  Cache-Control: public, max-age=31536000, immutable

# Icons rarely change but keep their names, so only a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Crawler files: short, so a change reaches search engines within the hour.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

